{
  "name": "@argszero/dsh-surrogate-sanitizer-guard",
  "version": "0.1.0",
  "description": "Repair lone UTF-16 surrogates on the outgoing model request, so one truncated string in a session's durable history cannot make every later turn fail.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "deepseek-harness",
    "llm",
    "unicode",
    "surrogate"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/argszero/dsh-surrogate-sanitizer-guard.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "^0.2.1-rc.2"
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 test/*.spec.mjs",
    "smoke": "node scripts/mount-smoke.mjs",
    "mutation": "node scripts/inject-defects.mjs"
  }
}
